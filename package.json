{
  "name": "transitiq",
  "version": "0.0.0",
  "private": true,
  "description": "TransitIQ — public transport route and timing tracker with a women-safety layer (SI-05+). Simulated data.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "functions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace shared --if-present && npm run build --workspace web --if-present && npm run build --workspace functions --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "verify:demo": "tsx scripts/verify-demo.ts",
    "seed:emulator": "tsx functions/src/scripts/seedFirestore.ts",
    "seed:prod": "tsx functions/src/scripts/seedFirestore.ts --prod",
    "grant:operator": "tsx scripts/grant-operator.ts",
    "eval:eta": "tsx functions/src/eval/etaMae.ts",
    "eval:safewait": "tsx functions/src/eval/safeWait.ts",
    "test": "npm run test:shared && npm run test:web && npm run test:functions",
    "test:shared": "npm test --workspace shared --if-present",
    "test:web": "npm test --workspace web --if-present",
    "test:functions": "npm test --workspace functions --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
