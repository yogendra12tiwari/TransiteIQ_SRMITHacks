rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model & Architecture (ARCHITECTURE.md & PRD §7.2)
    // ===============================================================
    // 1. Public Read:  stops, routes, safeSpots, helpPoints, history, sim/live, alerts
    // 2. Capability:   trips/{token} (get-only while expiresAt > request.time)
    // 3. Operator:     sim/overrides, reports, clusters, aggregates, reviewQueue,
    //                  incidents, routeScores, logs
    // 4. Internal:     rateLimits/{sha256_hash} (default deny)
    // ===============================================================

    function isOperator() {
      return request.auth != null && request.auth.token.role == "operator";
    }

    // Static network data & emergency help points: public read, strictly immutable by clients
    match /stops/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /routes/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /safeSpots/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /helpPoints/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /history/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Live simulator state: public read, operator-only write
    match /sim/live {
      allow read: if true;
      allow write: if isOperator();
    }

    // Simulator driver overrides (PRD §7.2, D9): operator-only read & write
    match /sim/overrides {
      allow read, write: if isOperator();
    }

    // Alerts: public read, operator-only write
    match /alerts/{id} {
      allow read: if true;
      allow write: if isOperator();
    }

    // Shared trip links (PRD §7.2, M5-25, M5-26):
    // Public get by unguessable 128-bit token while active; list strictly denied to prevent enumeration.
    // Client-fallback create requires valid schema and <= 2 hours expiry.
    // Update requires authenticated caller with matching ownerKeyHash or operator role; delete denied.
    match /trips/{token} {
      function isValidTripCreate() {
        let d = request.resource.data;
        return d.token is string && d.token == token
          && d.routeId is string && d.routeId.size() > 0 && d.routeId.size() <= 100
          && d.boardingStopId is string && d.boardingStopId.size() > 0 && d.boardingStopId.size() <= 100
          && d.destinationStopId is string && d.destinationStopId.size() > 0 && d.destinationStopId.size() <= 100
          && d.state in ['PLANNED', 'WAITING', 'BOARDED']
          && (d.expiresAt is int || d.expiresAt is float)
          && (d.createdAt is int || d.createdAt is float)
          && d.expiresAt <= request.time.toMillis() + 7200000;
      }

      function isValidTripUpdate() {
        return request.auth != null && (
          (request.resource.data.ownerKeyHash == resource.data.ownerKeyHash) ||
          isOperator()
        );
      }

      allow get: if resource.data.expiresAt > request.time.toMillis();
      allow list: if false;
      allow create: if isValidTripCreate();
      allow update: if isValidTripUpdate();
      allow delete: if false;
    }

    // Community reports, aggregates, operator review queue, and audit logs (PRD §7.2, M6-07)
    match /reports/{reportId} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /clusters/{clusterId} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /aggregates/{docPath=**} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /reviewQueue/{queueId} {
      allow read: if isOperator();
      allow create: if false;
      allow update: if isOperator();
      allow delete: if false;
    }

    // Incidents and route reliability scores (ARCHITECTURE.md): operator-only read & write
    match /incidents/{incidentId} {
      allow read, write: if isOperator();
    }

    match /routeScores/{scoreId} {
      allow read, write: if isOperator();
    }

    match /logs/{logId} {
      allow read: if isOperator();
      allow write: if false;
    }

    // Internal rate limits: server-managed only (Decision D3, default deny)
    match /rateLimits/{hash} {
      allow read, write: if false;
    }

    // Default deny for all other collections until subsequent milestone rules are deployed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
