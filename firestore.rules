rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Static network data: public read, strictly immutable by clients
    match /stops/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /routes/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /safeSpots/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /history/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for all other collections until subsequent milestone rules are deployed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
